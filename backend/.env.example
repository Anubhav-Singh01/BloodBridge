# BloodBridge AI backend environment.
# Copy this file to .env and fill in values locally. Never commit .env.
# The running server reads NODE_ENV, PORT, FRONTEND_URL, BACKEND_URL and DATABASE_URL; it will not start
# without DATABASE_URL set (Batch 3.6).
# DATABASE_URL_DIRECT, TEST_DATABASE_URL and CONFIRM_* are read by the db scripts only, never by the server.
# The other variables are reserved for later phases and are not used yet.

# Runtime
NODE_ENV=development
PORT=5000

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (Neon PostgreSQL).
# DATABASE_URL: the runtime connection (the pooled host, the one with "-pooler"). Required: the backend
#   reads this at startup (src/config/env.ts) and refuses to start without it (Batch 3.6).
# DATABASE_URL_DIRECT: direct (non-pooled) connection, used only by the migration, seed and probe scripts,
#   never by the running server. If empty, those scripts fall back to DATABASE_URL.
#   Point both at the DEV branch, never at production.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Test branch, used only by automated database tests. Must be a different database from the dev branch.
TEST_DATABASE_URL=
# Safety confirmations for the db scripts. Set each to the exact host (no scheme, no port, no path) of
# the URL you intend to target. `npm run db:target` prints the host. Scripts refuse to run without a match.
CONFIRM_DB_HOST=
CONFIRM_TEST_DB_HOST=

# Clerk. Reserved.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Google Maps. Reserved.
# MAPS_ENABLED is the kill switch described in ARCHITECTURE.md: when false, no Google API
# is called and straight-line estimates are used instead.
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# ML service. Reserved.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=

# Cron. Reserved.
CRON_SECRET=

# Admin bootstrap. Reserved. Emails used by the admin bootstrap seed script described in
# ARCHITECTURE.md. The exact format is decided when that script is implemented.
ADMIN_BOOTSTRAP_EMAILS=

# Notification providers. Reserved.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
