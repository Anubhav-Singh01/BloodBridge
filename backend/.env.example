# BloodBridge AI backend environment.
# Copy this file to .env and fill in values locally. Never commit .env.
# Phase 2 reads only NODE_ENV, PORT, FRONTEND_URL and BACKEND_URL.
# The other variables are reserved for later phases and are not used yet.

# Runtime
NODE_ENV=development
PORT=5000

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (Neon PostgreSQL). Reserved. Phase 2 never connects to it.
DATABASE_URL=

# Clerk. Reserved.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Google Maps. Reserved.
# MAPS_ENABLED is the kill switch described in ARCHITECTURE.md: when false, no Google API
# is called and straight-line estimates are used instead.
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# ML service. Reserved.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=

# Cron. Reserved.
CRON_SECRET=

# Admin bootstrap. Reserved. Emails used by the admin bootstrap seed script described in
# ARCHITECTURE.md. The exact format is decided when that script is implemented.
ADMIN_BOOTSTRAP_EMAILS=

# Notification providers. Reserved.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
