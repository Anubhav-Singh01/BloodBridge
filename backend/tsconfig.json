{
  "compilerOptions": {
    // Environment: Node 22, ES modules
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "types": ["node"],

    // Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Output
    "sourceMap": true,

    // Strictness (unchanged from the existing file)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Module hygiene (unchanged from the existing file)
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
