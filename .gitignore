# Environment (real secrets live in local .env files and are never committed)
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# Build output
dist/
build/

# Python
.venv/
__pycache__/
*.py[cod]

# Test coverage and logs
coverage/
logs/
*.log

# ML: trained model artifacts, laid out as in ML.md:
#   ml-service/models/<model_version>/model.joblib
#   ml-service/models/<model_version>/metadata.json
# Anchored to ml-service/models/ so the ml-service/app/models/ code package is NOT ignored.
ml-service/models/*
!ml-service/models/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
Desktop.ini
