# BloodBridge AI ML service environment.
# Copy this file to .env and fill in values locally. Never commit .env.

# Shared secret the backend sends in the X-Service-Secret header (at least 16 characters).
# It must equal ML_SERVICE_SECRET in backend/.env. If empty, protected endpoints such as
# GET /model reject every request with 503 SERVICE_NOT_CONFIGURED.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_SERVICE_SECRET=

# Which model artifact to use: the name of a folder under models/ (models/<model_version>/).
# Leave empty for no model: /model then returns 503 and the backend uses its fallback ranker.
# There is no automatic "latest": choosing a version is an explicit, reviewed step (ML.md section 8).
ML_MODEL_VERSION=
