# BloodBridge AI frontend environment (Vite).
# Copy this file to .env and fill in values locally. Never commit .env.
# Only PUBLIC values belong here: everything prefixed VITE_ is embedded in the browser bundle.
# Never put server secrets (Clerk secret key, database URL, ML secret, ...) in this file.
# All variables are reserved for later phases and are not read by any code yet.

# Backend base URL, without /api/v1.
VITE_API_URL=http://localhost:5000

# Clerk publishable key (public by design).
VITE_CLERK_PUBLISHABLE_KEY=

# Google Maps BROWSER key, restricted by HTTP referrer and to the APIs the frontend uses
# (see ARCHITECTURE.md section 8). Not the server key.
VITE_GOOGLE_MAPS_API_KEY=
